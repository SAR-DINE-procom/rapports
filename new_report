#!/bin/bash

# Script pour créer un nouveau rapport à partir du template
# Usage: ./new_report <nom_du_rapport>

# Vérification du nombre de paramètres
if [ $# -ne 1 ]; then
    echo "Usage: $0 <nom_du_rapport>"
    echo "Exemple: $0 mon_nouveau_rapport"
    exit 1
fi

# Récupération du nom du rapport
nom_rapport="$1"

# Vérification que le nom ne contient que des caractères valides
if [[ ! "$nom_rapport" =~ ^[a-zA-Z0-9_-]+$ ]]; then
    echo "Erreur: Le nom du rapport ne doit contenir que des lettres, chiffres, tirets et underscores"
    exit 1
fi

# Chemins des dossiers
template_dir="templates/create_rapport"
dest_dir="src/$nom_rapport"

# Vérification que le template existe
if [ ! -d "$template_dir" ]; then
    echo "Erreur: Le dossier template '$template_dir' n'existe pas"
    exit 1
fi

# Vérification que le rapport n'existe pas déjà
if [ -d "$dest_dir" ]; then
    echo "Erreur: Un rapport avec le nom '$nom_rapport' existe déjà dans '$dest_dir'"
    echo "Choisissez un autre nom ou supprimez le rapport existant."
    exit 1
fi

# Création du dossier src s'il n'existe pas
if [ ! -d "src" ]; then
    mkdir -p src
fi

# Copie du template vers le nouveau dossier
echo "Création du nouveau rapport '$nom_rapport'..."
cp -r "$template_dir" "$dest_dir"

if [ $? -eq 0 ]; then
    echo "✓ Rapport '$nom_rapport' créé avec succès dans '$dest_dir'"
    echo ""
    echo "Vous pouvez consulter le README.md pour l'utilisation de la base du rapport."
else
    echo "✗ Erreur lors de la copie du template"
    exit 1
fi